{
  "name": "team-bridge",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm -r --filter ./packages/protocol run build && pnpm -r --filter ./packages/bridge run build",
    "typecheck": "pnpm -r run typecheck",
    "hub:dev": "pnpm --filter @team-bridge/hub dev",
    "hub:deploy": "pnpm --filter @team-bridge/hub deploy"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
