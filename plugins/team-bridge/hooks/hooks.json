{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "team",
            "tool": "team_codex_event",
            "input": {
              "event": "SessionStart",
              "cwd": "${cwd}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "team",
            "tool": "team_codex_event",
            "input": {
              "event": "UserPromptSubmit",
              "cwd": "${cwd}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "team",
            "tool": "team_codex_event",
            "input": {
              "event": "PostToolUse",
              "cwd": "${cwd}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "team",
            "tool": "team_codex_event",
            "input": {
              "event": "Stop",
              "cwd": "${cwd}"
            },
            "timeout": 3
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "team",
            "tool": "team_codex_event",
            "input": {
              "event": "Interrupt",
              "cwd": "${cwd}"
            },
            "timeout": 3
          }
        ]
      }
    ]
  }
}
