{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Legacy deployment ID: preserve the existing Durable Object namespace and room data.
  "name": "team-bridge-hub",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  // custom domain: wrangler creates the DNS record + certificate on deploy
  "routes": [{ "pattern": "hub.agentroom.online", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    // days without any activity before a room is destroyed
    "ROOM_IDLE_DAYS": "7"
  },
  "durable_objects": {
    "bindings": [{ "name": "TEAM_ROOM", "class_name": "TeamRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TeamRoom"] }],
  "observability": { "enabled": true }
}
